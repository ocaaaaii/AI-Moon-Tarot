# Copy this file to .env.local and fill in your real key.
# Never commit .env.local — it's already in .gitignore.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# For the developer contact bubble (DeveloperBubble → /api/contact)
# Get a free key at https://resend.com — free tier lets you send to your own email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender for the feedback survey. Optional — defaults to Resend's shared
# sandbox domain (onboarding@resend.dev), which Gmail files as spam because
# it has no SPF/DKIM of your own. Verify a domain in Resend, then set this
# to e.g. "AI Tarot <survey@your-domain.com>".
RESEND_FROM=
